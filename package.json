{
    "name": "os-sim",
    "productName": "os-sim",
    "version": "1.0.5",
    "private": true,
    "description": "My Electron application description",
    "keywords": [],
    "license": "MIT",
    "author": {
        "name": "Eduardo Vinicius Dias",
        "email": "142503604+ediasv@users.noreply.github.com"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.22.1",
            "onFail": "warn"
        }
    },
    "main": ".vite/build/main.cjs",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "release": "electron-forge release",
        "format": "oxfmt --write",
        "lint": "oxlint && oxfmt --check",
        "lint:fix": "oxlint --fix && oxfmt --write",
        "typecheck": "vue-tsc --noEmit && tsc --noEmit -p src/core/tsconfig.json",
        "publish": "electron-forge publish",
        "test": "vitest run",
        "prepare": "git config core.hooksPath .githooks || exit 0"
    },
    "devDependencies": {
        "@electron-forge/cli": "^8.0.1",
        "@electron-forge/maker-deb": "^8.0.1",
        "@electron-forge/maker-rpm": "^8.0.1",
        "@electron-forge/maker-squirrel": "^8.0.1",
        "@electron-forge/maker-zip": "^8.0.1",
        "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
        "@electron-forge/plugin-fuses": "^8.0.1",
        "@electron-forge/plugin-vite": "^8.0.1",
        "@electron-forge/publisher-github": "^8.0.1",
        "@electron/fuses": "^2.1.3",
        "@types/electron-squirrel-startup": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "electron": "44.7.0",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vitest": "5.0.3",
        "vue-tsc": "^3.3.12"
    },
    "dependencies": {
        "electron-squirrel-startup": "^1.0.1",
        "vue": "^3.5.43"
    },
    "allowScripts": {
        "electron-winstaller@5.4.4": true,
        "fsevents@2.3.3": true
    }
}
