{
    "compilerOptions": {
        "target": "ESNext",
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "strict": true,
        "sourceMap": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*", "src/**/*.vue", "*.ts", "*.mts"]
}
